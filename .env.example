# 复制本文件为 .env 并填入真实值；.env 不会被提交。
# 生成密钥：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=请替换为随机生成的密钥
DJANGO_ALLOWED_HOSTS=example.com,127.0.0.1
# 生产 HTTPS 部署时设为 True（自动启用 SSL 跳转/HSTS/安全 Cookie）
DJANGO_SECURE=True

DB_ENGINE=django.db.backends.postgresql
DB_NAME=repair_system_db
DB_USER=repair_app
DB_PASSWORD=请替换为强密码
DB_HOST=127.0.0.1
DB_PORT=5432
